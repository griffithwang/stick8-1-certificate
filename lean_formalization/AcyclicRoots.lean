def Case.Valid (c : Case) : Prop := c.points.length=5 ∧ Function.Injective c.q ∧
  c.root<sourceNodes.size ∧ expand 64 sourceNodes c.root=some (HomogeneousAcyclic.constraint c.q)
instance (c : Case) : Decidable c.Valid :=
  inferInstanceAs (Decidable (_ ∧ (∀ a b : Fin 5, c.q a=c.q b → a=b) ∧ _ ∧ _))

theorem casesVerified : cases.all (fun c => decide c.Valid)=true := by native_decide
theorem caseCount : cases.length=126 := by native_decide
theorem rootsCovered : cases.map Case.root=(sourceRootIndices.drop 1588).take 126 := by native_decide

theorem root_true (f : Frame) (hp : f.Positive) (values : Nat → Bool) (hm : Models sourceNodes f.input values)
    (c : Case) (hc : c ∈ cases) : values c.root=true := by
  have hv : c.Valid := of_decide_eq_true (List.all_eq_true.mp casesVerified c hc)
  obtain ⟨hlen,hinj,hbound,hex⟩ := hv
  have he := expand_sound 64 sourceNodes f.input values hm c.root (HomogeneousAcyclic.constraint c.q) hex
  exact he.symm.trans (HomogeneousAcyclic.frame_geometric f hp c.q hinj)

theorem all_roots (f : Frame) (hp : f.Positive) (values : Nat → Bool) (hm : Models sourceNodes f.input values) :
    ∀ i ∈ (sourceRootIndices.drop 1588).take 126, values i=true := by
  intro i hi
  rw [← rootsCovered] at hi
  obtain ⟨c,hc,rfl⟩ := List.mem_map.mp hi
  exact root_true f hp values hm c hc

#print axioms all_roots
end Stick81.AcyclicRoots
